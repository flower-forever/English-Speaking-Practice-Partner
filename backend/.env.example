# ===== DashScope API (Qwen LLM + CosyVoice TTS) =====
# Get your API key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here
ALIYUN_API_KEY=sk-your_dashscope_api_key_here
ALIYUN_APP_ID=your_app_id_here

# Alibaba Cloud AccessKey (for services requiring AK/SK authentication)
# Get from: https://ram.console.aliyun.com/manage/ak
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret_here

# ===== Whisper STT Configuration =====
# Model size: tiny / base / small / medium (larger = more accurate but slower)
# 4GB VRAM → small, 8GB+ VRAM → medium
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ===== CosyVoice TTS Configuration =====
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_DEFAULT_VOICE=longanyang

# ===== Default LLM Model =====
DEFAULT_LLM_MODEL=qwen3.5-flash

# ===== Ollama Local LLM =====
OLLAMA_URL=http://localhost:11434

# ===== Server Configuration =====
HOST=127.0.0.1
PORT=8000
DEBUG=true
